# ============================================================
# MIRACLE Stock Listener Bot — Environment Variables
# Copy to `.env` and fill in actual values. DO NOT commit to git.
# ============================================================

# ── REQUIRED ────────────────────────────────────────────────

# Your bot token from @BotFather
STOCK_BOT_TOKEN=123456789:ABCDEF-your-token-here

# The group "Wwwwwwwwww High School 2.0" chat id (from /chatid command)
MD_CHAT_ID=-1003lZmmEKB0rhiNTU1

# Thread id of your private MD topic where daily digest lands
# Leave 0 and set ADMIN_USER_IDS below to receive via DM instead
MD_TOPIC_ID=0

# ── TOPIC IDS ──────────────────────────────────────────────
# Go to each topic, send `/chatid` → bot echoes `thread_id` → paste here

TOPIC_CCOM_ORDER=0
TOPIC_8COM_ORDER=0
TOPIC_TRANSFER=0
TOPIC_CCOM_GRN=0
TOPIC_8COM_GRN=0

# ── AUTHORISATION ──────────────────────────────────────────

# Telegram user id(s) allowed to run /today, /missing, etc.
# Find yours: DM the bot after it's running, send /chatid
ADMIN_USER_IDS=

# ── DAILY PUSH ─────────────────────────────────────────────

# Time for auto-digest. Uses server local time.
DAILY_PUSH_HOUR=20
DAILY_PUSH_MINUTE=0

# ── WEB DASHBOARD SYNC (optional but recommended) ─────────
# Push parsed logs to GitHub Gist so stock.html can read them.
# Uses the SAME gist ID as your existing MD dashboard (default below).
# Token needs "gist" scope only.

GITHUB_GIST_ID=ceb4064c9e2a6d37c6e52c3b02f04a1d
GITHUB_TOKEN=

# Debounce window in seconds — push bundled updates after this idle period
GIST_DEBOUNCE_SECONDS=30
